@page "/ConnectionSearch"
@attribute [StreamRendering]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using CougarConnect.Data
@using CougarConnect.Components.Account
@using CougarConnect.Models
@using CougarConnect.Services
@inject SupabaseService Supabase
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<ConnectionSearch> Logger

<PageTitle>Search Alumni</PageTitle>

<h1 class="cc-page-title">Search Alumni</h1>
<p class="cc-page-subtitle">Find fellow Cougars and grow your network.</p>

@if (errorMessage is not null)
{
    <StatusMessage Message="@errorMessage" IsError="true" />
}
@if (successMessage is not null)
{
    <StatusMessage Message="@successMessage" IsError="false" />
}

<div class="card mb-4">
    <div class="card-body">
        <div class="input-group input-group-lg">
            <span class="input-group-text" id="searchIcon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <input id="searchTerm" class="form-control" value="@searchTerm" @oninput="OnSearchInput"
                   placeholder="Start typing to search…" autocomplete="off"
                   aria-label="Search alumni" aria-describedby="searchIcon" />
            <select id="searchColumn" class="form-select cc-search-column" @bind="queryColumn" @bind:after="SearchUsers"
                    aria-label="Search by column">
                @foreach (var option in options)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        @if (isSearching)
        {
            <div class="mt-2 small text-muted">
                <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
                <span> Searching…</span>
            </div>
        }
    </div>
</div>

@if (items is not null && items.Any())
{
    <p class="text-muted small mb-3">@items.Length @(items.Length == 1 ? "alumnus" : "alumni") found</p>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
        @foreach (var result in items)
        {
            <div class="col">
                <AlumniCard Alumni="result">
                    <ActionContent>
                        <ConnectButton Recipient="result" CurrentUser="currentUser"
                                       Status="@GetStatus(result.Id)"
                                       OnRequestSent="OnRequestSent" />
                    </ActionContent>
                </AlumniCard>
            </div>
        }
    </div>
}
else if (hasSearched)
{
    <div class="cc-empty-state">
        <i class="bi bi-person-x" aria-hidden="true"></i>
        <h2>No results found</h2>
        <p>Try a different search term, or switch the "Search by" field.</p>
    </div>
}
else
{
    <div class="cc-empty-state">
        <i class="bi bi-search" aria-hidden="true"></i>
        <h2>Search the alumni directory</h2>
        <p>Search WSU alumni by name, email, major, city, or company.</p>
    </div>
}

@code {
    private string queryColumn = "All";
    private string[] options = { "All", "First", "Last", "Email", "GradYear", "City", "Major", "Company" };
    private Alumni[]? items;
    private string searchTerm = string.Empty;
    private bool hasSearched;
    private bool isSearching;

    private string? errorMessage;
    private string? successMessage;
    private string? currentUserEmail;
    private Alumni? currentUser;
    private Dictionary<long, string> connectionStatuses = new();
    private CancellationTokenSource? searchDebounceCts;

    private string? GetStatus(long id) =>
        connectionStatuses.TryGetValue(id, out var status) ? status : null;

    private void OnRequestSent(long recipientId)
    {
        connectionStatuses[recipientId] = "Pending";
        successMessage = "Connection request sent successfully!";
        errorMessage = null;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        currentUserEmail = user.Identity.Name;
        if (string.IsNullOrEmpty(currentUserEmail))
        {
            return;
        }

        try
        {
            var result = await Supabase.GetData<Alumni>(currentUserEmail, "Email");
            currentUser = result.FirstOrDefault();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load current user profile for {Email}", currentUserEmail);
            errorMessage = "Could not load your profile. Please try again later.";
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;

        // Debounce: cancel the previous pending search so we only query once the
        // user pauses typing, rather than firing a request on every keystroke.
        searchDebounceCts?.Cancel();
        var cts = new CancellationTokenSource();
        searchDebounceCts = cts;

        try
        {
            await Task.Delay(300, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (!cts.IsCancellationRequested)
        {
            await SearchUsers();
        }
    }

    protected async Task SearchUsers()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            items = null;
            hasSearched = false;
            errorMessage = null;
            return;
        }

        isSearching = true;
        errorMessage = null;
        try
        {
            var results = queryColumn == "All"
                ? await Supabase.SearchAlumni(searchTerm)
                : await Supabase.GetData<Alumni>(searchTerm, queryColumn);
            items = RankBySearchRelevance(results, searchTerm);
            await LoadConnectionStatuses();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Search failed for term {SearchTerm} on column {Column}", searchTerm, queryColumn);
            errorMessage = "Search failed. Please try again later.";
        }
        finally
        {
            hasSearched = true;
            isSearching = false;
        }
    }

    private async Task LoadConnectionStatuses()
    {
        connectionStatuses.Clear();
        if (currentUser is null || items is null)
        {
            return;
        }

        foreach (var result in items)
        {
            if (result.Id == currentUser.Id)
            {
                connectionStatuses[result.Id] = "Yourself";
                continue;
            }

            if (currentUser.ConnectionList is not null && currentUser.ConnectionList.Contains(result.Id))
            {
                connectionStatuses[result.Id] = "Connected";
                continue;
            }

            try
            {
                if (await Supabase.ConnectionRequestExists(currentUser.Id, result.Id))
                {
                    connectionStatuses[result.Id] = "Pending";
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to check connection status for {SelectedUserId}", result.Id);
                // Fail open: leave this result as a plain "Connect" button if the check errors.
            }
        }
    }

    // Orders results so the most relevant matches (name matches) appear first, rather
    // than in whatever order the backend returns them (e.g. searching "luis" surfaces
    // "Luis Zarate" above alumni that only match via their email address).
    private static Alumni[] RankBySearchRelevance(Alumni[] results, string term)
    {
        var normalized = term.Trim().ToLowerInvariant();
        return results
            .OrderByDescending(a => RelevanceScore(a, normalized))
            .ThenBy(a => $"{a.First} {a.Last}", StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static int RelevanceScore(Alumni a, string term)
    {
        var first = (a.First ?? string.Empty).ToLowerInvariant();
        var last = (a.Last ?? string.Empty).ToLowerInvariant();
        var full = $"{first} {last}".Trim();

        if (first == term || last == term || full == term)
        {
            return 5;
        }

        if (first.StartsWith(term) || last.StartsWith(term))
        {
            return 4;
        }

        if (first.Contains(term) || last.Contains(term))
        {
            return 3;
        }

        if ((a.Major ?? string.Empty).ToLowerInvariant().Contains(term)
            || (a.City ?? string.Empty).ToLowerInvariant().Contains(term)
            || (a.Company ?? string.Empty).ToLowerInvariant().Contains(term)
            || (a.GradYear ?? string.Empty).ToLowerInvariant().Contains(term))
        {
            return 2;
        }

        if ((a.Email ?? string.Empty).ToLowerInvariant().Contains(term))
        {
            return 1;
        }

        return 0;
    }
}
