<header class="cc-navbar navbar">
    <div class="container-fluid">
        <a class="navbar-brand cc-brand" href="">
            <i class="bi bi-mortarboard-fill" aria-hidden="true"></i>
            Cougar<span class="cc-brand-accent">Connect</span>
        </a>

        <input type="checkbox" id="navToggle" class="cc-nav-toggle" aria-label="Toggle navigation menu" />

        <nav class="cc-nav-links" onclick="document.getElementById('navToggle').click()">
            <AuthorizeView>
                <Authorized>
                    <NavLink class="cc-nav-link" href="ConnectionSearch">
                        <i class="bi bi-search" aria-hidden="true"></i> Connection Search
                    </NavLink>
                    <NavLink class="cc-nav-link" href="Connections">
                        <i class="bi bi-people-fill" aria-hidden="true"></i> Connections
                    </NavLink>
                    <NavLink class="cc-nav-link" href="RecentActivity">
                        <i class="bi bi-bell-fill" aria-hidden="true"></i> Recent Activity
                    </NavLink>
                    <NavLink class="cc-nav-link" href="Account/Manage">
                        <i class="bi bi-person-gear" aria-hidden="true"></i> Manage Account
                    </NavLink>
                    <form action="Account/Logout" method="post" class="cc-nav-logout-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="Account/Login" />
                        <button type="submit" class="cc-nav-link cc-nav-link-button">
                            <i class="bi bi-box-arrow-left" aria-hidden="true"></i> Logout
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="cc-nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-house-door-fill" aria-hidden="true"></i> Home
                    </NavLink>
                    <NavLink class="cc-nav-link" href="Account/Register">
                        <i class="bi bi-person-plus" aria-hidden="true"></i> Register
                    </NavLink>
                    <NavLink class="cc-nav-link" href="Account/Login">
                        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Login
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</header>
