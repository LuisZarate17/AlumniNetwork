@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Forgot password confirmation</PageTitle>

<AuthCard Title="Check your email">
    <ChildContent>
        <p class="text-muted"><i class="bi bi-envelope-check me-1" aria-hidden="true"></i> Please check your email for a link to reset your password.</p>
    </ChildContent>
    <FooterContent>
        <p><a href="Account/Login">Back to login</a></p>
    </FooterContent>
</AuthCard>
